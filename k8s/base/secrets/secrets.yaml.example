apiVersion: v1
kind: Secret
metadata:
  name: agentx-backend-secrets
  namespace: agentx
  labels:
    app.kubernetes.io/name: agentx-backend
    app.kubernetes.io/component: backend
type: Opaque
stringData:
  # REQUIRED: JWT signing key
  JWT_SECRET_KEY: "<your-jwt-secret-key>"

  # REQUIRED: PostgreSQL connection string
  DATABASE_URL: "postgresql://<user>:<password>@<rds-endpoint>:5432/agentx"

  # REQUIRED: API key for service-to-service auth (Lambda -> Backend)
  SERVICE_API_KEY: "<your-service-api-key>"

  # REQUIRED: Lambda function ARN for scheduled tasks
  LAMBDA_FUNCTION_ARN: "arn:aws:lambda:<region>:<account-id>:function:agentx-schedule-executor"

  # REQUIRED: EventBridge Scheduler execution role ARN
  SCHEDULE_ROLE_ARN: "arn:aws:iam::<account-id>:role/agentx-eventbridge-scheduler-role"

  # OPTIONAL: Azure AD SSO (leave empty to disable)
  AZURE_CLIENT_ID: ""
  AZURE_TENANT_ID: ""
  AZURE_CLIENT_SECRET: ""
